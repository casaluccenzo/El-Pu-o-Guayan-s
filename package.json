{
  "name": "casa-lucenzo",
  "version": "1.0.4",
  "description": "Sistema de gestión de inventario y caja para Casa Lucenzo.",
  "main": "index.html",
  "scripts": {
    "dev": "node scripts/devserver.js",
    "build": "node scripts/build.js",
    "test": "node tests/unit.test.js && node tests/build.test.js",
    "test:convergence": "node tests/powersync-convergence.test.js",
    "lint": "eslint .",
    "generate:qr": "node scripts/generate-qr.js",
    "vendor:powersync": "npx --yes @powersync/web@2.4.1 copy-assets --output js/powersync/vendor",
    "version": "node scripts/sync-desktop-version.js && git add desktop/package.json",
    "release:web": "npm run build && git push origin HEAD:main",
    "release:desktop": "npm run build && npm --prefix desktop run publish",
    "release": "npm run test && npm version patch -m \"release v%s\" && npm run release:web && npm run release:desktop && git push --tags"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "sharp": "^0.35.4"
  }
}
